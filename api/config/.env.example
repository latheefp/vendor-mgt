#!/usr/bin/env bash
# -----------------------------------------------------------------
# Host-side console environment.
#
#   cp config/.env.example config/.env
#
# Only used when you run bin/cake or phpunit FROM THE HOST. Inside
# docker compose the environment is injected by compose and this file
# is ignored entirely (bootstrap.php skips it when APP_NAME is
# already set).
#
# Note the port: from the host MySQL is reachable on the published
# port (DB_EXPOSED_PORT in the root .env), not on 3306.
#
# Having this file in production is a SECURITY RISK — it is for local
# console work only.
# -----------------------------------------------------------------

export APP_NAME="Grand VendorService"
export DEBUG="true"
export APP_ENCODING="UTF-8"
export APP_DEFAULT_LOCALE="en_IN"
export APP_DEFAULT_TIMEZONE="Asia/Kolkata"
export APP_FULL_BASE_URL="http://localhost:7007"
export SECURITY_SALT="dev-only-salt-change-me-in-production-0123456789abcdef"

# ---- database (host -> published MySQL port) ---------------------
export DB_HOST="127.0.0.1"
export DB_PORT="7002"
export DB_NAME="vendorservice"
export DB_USERNAME="vendorservice"
export DB_PASSWORD="secret"
export TEST_DB_NAME="vendorservice_test"

# ---- redis (SHARED instance — always namespace) ------------------
# Prefix keeps our keys out of other apps' way; the database index
# keeps a neighbouring FLUSHDB from wiping our sessions.
export REDIS_HOST="127.0.0.1"
export REDIS_PORT="7005"
export REDIS_PASSWORD=""
export REDIS_PREFIX="gvs:"
export REDIS_DATABASE="0"

# Host PHP usually has no ext-redis (the Docker image installs it), so
# console work from the host caches to disk. Inside the container this
# is 'redis'. Set it to 'redis' here too once you have the extension:
#   pecl install redis
export CACHE_ENGINE="file"

# ---- mail --------------------------------------------------------
# No local mail sink. Empty EMAIL_HOST means Cake uses DebugTransport:
# mail is rendered and logged, never sent. Point it at a real SMTP
# server when you need delivery.
export EMAIL_HOST=""
export EMAIL_PORT="587"
export EMAIL_FROM="service@grandvendorservice.local"
