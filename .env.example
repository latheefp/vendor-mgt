####################################################################
# Grand VendorService — copy to .env and adjust.
#   cp .env.example .env
####################################################################

# ---- edge -------------------------------------------------------
# Every host port lives in the 7000-7010 block.
#
#   7007  app            <- open http://localhost:7007
#   7001  Traefik dashboard
#   7002  MySQL
#   7004  Adminer
#   7005  Redis
#
# If you move HTTP_PORT, move APP_FULL_BASE_URL with it — Cake builds
# absolute URLs (OTP links, invoice mails) from that value.
HTTP_PORT=7007
TRAEFIK_DASHBOARD_PORT=7001
APP_FULL_BASE_URL=http://localhost:7007

# ---- app --------------------------------------------------------
DEBUG=true

# Generate a real one before any deployment:
#   openssl rand -hex 32
SECURITY_SALT=dev-only-salt-change-me-in-production-0123456789abcdef

# ---- database ---------------------------------------------------
DB_NAME=vendorservice
DB_USERNAME=vendorservice
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
TEST_DB_NAME=vendorservice_test

# Host port for connecting a GUI client.
DB_EXPOSED_PORT=7002

# ---- other published ports --------------------------------------
ADMINER_PORT=7004
REDIS_EXPOSED_PORT=7005

# ---- mail -------------------------------------------------------
# There is no local mail sink. Leave EMAIL_HOST empty and Cake uses
# DebugTransport: mail is rendered and logged, never sent. Fill these
# in to deliver through a real SMTP server.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TLS=false

# ---- redis ------------------------------------------------------
# This Redis instance is SHARED with other applications. Two things
# keep us out of their way, and you want both:
#
#   REDIS_PREFIX    namespaces every key we write
#   REDIS_DATABASE  puts us on our own numbered database
#
# Prefix alone is not enough — a neighbouring app running FLUSHDB
# would still wipe our sessions and log out every technician who is
# mid-job. Point these at your shared host in production.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=gvs:
REDIS_DATABASE=0

# 'redis' or 'file'. Use file only if Redis is genuinely unavailable.
CACHE_ENGINE=redis

# ---- evidence storage (Cloudflare R2 / any S3) -------------------
# Left blank in dev: uploads fall back to the local filesystem.
# Closure photos are dispute evidence — in production these must go
# to versioned object storage, never a container volume.
S3_ENDPOINT=
S3_BUCKET=gvs-evidence
S3_KEY=
S3_SECRET=
S3_REGION=auto
