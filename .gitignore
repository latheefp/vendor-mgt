# ---- secrets ----------------------------------------------------
.env
.env.local
*.pem

# ---- api (CakePHP) ----------------------------------------------
/api/vendor/
# app_local.php is tracked on purpose: every value in it comes from an
# environment variable, so it carries no secrets and needs to ship in
# the image for production to have working DB/Redis/email/storage config.
/api/logs/*
!/api/logs/.gitkeep
/api/tmp/*
!/api/tmp/.gitkeep
/api/webroot/uploads/*
!/api/webroot/uploads/.gitkeep
/api/.phpunit.cache/
/api/.phpunit.result.cache

# ---- web (React) ------------------------------------------------
/web/node_modules/
/web/dist/
/web/.vite/
/web/*.local

# ---- tooling ----------------------------------------------------
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
*.log
